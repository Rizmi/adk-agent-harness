# ADK Agent Harness — Environment Configuration Template
# Copy this file to .env and fill in the API key for your chosen ADK_MODEL.

# -----------------------------------------------------------------------------
# Server & Network
# -----------------------------------------------------------------------------
AGENT_HOST=127.0.0.1
AGENT_PORT=4096

# Optional Web Chat UI (set to false to run completely headless without UI)
ADK_ENABLE_WEB_UI=true

# Optional HTTP Basic Authentication (leave AGENT_SERVER_PASSWORD blank to disable)
AGENT_SERVER_USERNAME=operator
AGENT_SERVER_PASSWORD=

# Comma-separated CORS origins (leave blank to allow localhost / private LAN / Tailscale ranges)
ADK_ALLOWED_ORIGINS=

# Timezone injected into live turn headers (IANA format, e.g. UTC, America/New_York, Europe/Berlin)
ADK_TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Optional Path Overrides (defaults shown - all relative to the project root)
# -----------------------------------------------------------------------------
# ADK_AGENTS_DIR=agents
# ADK_SKILLS_DIR=skills
# ADK_MEMORY_FILE=MEMORY.md
# ADK_MCP_DIR=mcp
# ADK_MCP_SERVERS_FILE=mcp/servers.json
# ADK_MODELS_FILE=models.json
# ADK_ENV_FILE=.env
# Per-server MCP port overrides (optional): MCP_PORT_FILESYSTEM=8101
# MCP_PORT_MEMORY=8102
# MCP_PORT_SKILLS=8103

# -----------------------------------------------------------------------------
# Model Selection (must match a key in models.json)
# -----------------------------------------------------------------------------
ADK_MODEL=openai-gpt4o

# Provider API Keys (only the key referenced by your active ADK_MODEL is required)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

# -----------------------------------------------------------------------------
# Sessions, Compaction & Memory
# -----------------------------------------------------------------------------
ADK_DATABASE_URL=sqlite+aiosqlite:///sessions.db
ADK_COMPACTION_RETENTION_SIZE=15
ADK_MEMORY_FILE=MEMORY.md

# -----------------------------------------------------------------------------
# MCP & Sandboxed Workspace Directories
# -----------------------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_BASE_PORT=8101

# Authorized directories for mcp/filesystem tools (relative to project root or absolute)
ADK_WORKSPACE_DIR=workspace
ADK_ARTIFACTS_DIR=artifacts
ADK_TMP_DIR=tmp
# Optional comma-separated overrides:
# ADK_ALLOWED_READ_DIRS=workspace,artifacts,tmp
# ADK_ALLOWED_WRITE_DIRS=workspace,artifacts,tmp
